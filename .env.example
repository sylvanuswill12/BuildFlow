# Runtime
NODE_ENV=production
PORT=3000
# Local email/password session signing. Generate with: openssl rand -base64 48
APP_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional application administrators (comma-separated email addresses)
ADMIN_EMAILS=
# Persistent MySQL-compatible database (required for accounts, projects and credits)
# Aiven's ssl-mode=REQUIRED URL parameter is normalized to mysql2 TLS server-side.
DATABASE_URL=
# Optional legacy private filesystem fallback for old uploaded images; new uploads are stored in MySQL
FILE_STORAGE_DIR=var/uploads
# Choose at least one AI provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPEN_ROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENAI_LIKE_API_BASE_URL=
OPENAI_LIKE_API_KEY=
# OmniRoute gateway (base URL must end in /v1; keep both values server-side)
OMNIROUTE_API_BASE_URL=
OMNIROUTE_API_KEY=
OLLAMA_API_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional browser integrations
VITE_GOOGLE_MAPS_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
# Optional BuildFlow-to-Netlify publishing from the workspace
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
