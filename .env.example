# Runtime
NODE_ENV=production

# Manus OAuth and signed sessions (required for login)
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_BROWSER_KEY=

# Persistent MySQL-compatible database (required for users, projects and credits)
DATABASE_URL=

# Choose at least one AI provider
MANUS_API_URL=
MANUS_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPEN_ROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENAI_LIKE_API_BASE_URL=
OPENAI_LIKE_API_KEY=
OLLAMA_API_BASE_URL=
OLLAMA_API_KEY=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Supabase client diagnostics
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional BuildFlow-to-Netlify publishing from the workspace
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
